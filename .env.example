# Public URL of the site, used for social preview images (e.g. the production domain).
NEXT_PUBLIC_SITE_URL=

# Set by Vercel on every deploy (production, preview, development); pieces marked
# `held` are hidden when it is "production". Leave unset locally.
# VERCEL_ENV=

# Sanity (CMS). The project id is public (it is sent to the browser); without it
# the site uses its local content and /admin cannot sign in.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: the API date the queries are written against.
# NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# DeepL key for scripts/translate.mts (machine translation of pt, zh, ja). In CI it
# is the GitHub repository secret DEEPL_API_KEY; the site itself never reads it.
# DEEPL_API_KEY=
